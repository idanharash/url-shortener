# Copy to .env (git-ignored) and set the two passwords and the API key before the first `docker compose up`.
# Choose any values: PostgreSQL and RabbitMQ are created with them, and the API receives the same values
# through docker-compose.yml. They are deliberately empty so no secret is ever committed; Compose refuses
# to start until they are set.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_USER=postgres
POSTGRES_DB=url_shortener
POSTGRES_PASSWORD=

RABBITMQ_USERNAME=urlshortener
RABBITMQ_PASSWORD=

# Required for POST /api/shorten (header X-Api-Key). At least 32 characters, for example:
#   Git Bash / Linux / macOS:  openssl rand -hex 32
#   PowerShell (any version):  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
API_KEY=
