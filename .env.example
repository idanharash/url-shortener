# Copy to .env (git-ignored) and set BOTH passwords before the first `docker compose up`.
# Choose any values: PostgreSQL and RabbitMQ are created with them, and the API receives the same values
# through docker-compose.yml. They are deliberately empty so no password is ever committed; Compose refuses
# to start until they are set.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_USER=postgres
POSTGRES_DB=url_shortener
POSTGRES_PASSWORD=

RABBITMQ_USERNAME=urlshortener
RABBITMQ_PASSWORD=
