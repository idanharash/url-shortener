FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore UrlShortener.sln
RUN dotnet publish UrlShortener.Worker/UrlShortener.Worker.csproj -c Release -o /app

# ASP.NET Core runtime (not the plain runtime): the /metrics endpoint is served by Kestrel.
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
EXPOSE 9091
ENTRYPOINT ["dotnet", "UrlShortener.Worker.dll"]
