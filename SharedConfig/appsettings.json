{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5000"
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "Window": "00:01:00"
  },
  "Postgres": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "url_shortener",
    "Username": "postgres",
    "Password": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "EntryTtl": "1.00:00:00"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "urlshortener",
    "Password": "",
    "QueueName": "click-events"
  },
  "Worker": {
    "MetricsPort": 9091
  },
  "OpenTelemetry": {
    "ServiceName": "UrlShortener",
    "OtlpEndpoint": "http://localhost:4317",
    "ConsoleExporter": false
  },
  "AllowedHosts": "*"
}
